    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"temperature\": 0.7,\n  \"max_tokens\": 200,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You write short, friendly morning briefings.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Create a friendly 3-sentence morning briefing using this information.\\n\\nWeather in Rawalpindi:\\nTemperature: {{$('Get Rawalpindi Weather').item.json.current.temperature_2m}} °C\\nFeels like: {{$('Get Rawalpindi Weather').item.json.current.apparent_temperature}} °C\\nHumidity: {{$('Get Rawalpindi Weather').item.json.current.relative_humidity_2m}}%\\nWind: {{$('Get Rawalpindi Weather').item.json.current.wind_speed_10m}} km/h\\n\\nCountry of the day:\\n{{$('Get Country').item.json.data.objects[0].names.common}}\\n\\nCapital:\\n{{$('Get Country').item.json.data.objects[0].capitals[0].name}}\\n\\nPopulation:\\n{{$('Get Country').item.json.data.objects[0].population}}\\n\\nRules:\\n- Exactly 3 sentences.\\n- Friendly and useful.\\n- Mention today's weather.\\n- Mention the country of the day.\\n- Do not use bullet points.\\n- Do not mention that you are an AI.\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        416,
        -160
      ],
      "id": "2ecce58e-87f8-44ce-8790-eedde4956d04",
      "name": "Generate AI Briefing",
      "credentials": {
        "httpHeaderAuth": {
          "id": "x18NgvqSqBOGXzbg",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const weather = $('Get Rawalpindi Weather').first().json;\nconst countryResponse = $('Get Country').first().json;\nconst aiResponse = $('Generate AI Briefing').first().json;\n\nconst country =\n  countryResponse.data?.objects?.[0] ||\n  countryResponse.data?.[0] ||\n  {};\n\nconst current = weather.current || {};\n\nconst weatherCodes = {\n  0: \"Clear sky\",\n  1: \"Mainly clear\",\n  2: \"Partly cloudy\",\n  3: \"Overcast\",\n  45: \"Fog\",\n  48: \"Depositing rime fog\",\n  51: \"Light drizzle\",\n  53: \"Moderate drizzle\",\n  55: \"Dense drizzle\",\n  61: \"Slight rain\",\n  63: \"Moderate rain\",\n  65: \"Heavy rain\",\n  71: \"Slight snow\",\n  73: \"Moderate snow\",\n  75: \"Heavy snow\",\n  80: \"Slight rain showers\",\n  81: \"Moderate rain showers\",\n  82: \"Violent rain showers\",\n  95: \"Thunderstorm\",\n  96: \"Thunderstorm with slight hail\",\n  99: \"Thunderstorm with heavy hail\"\n};\n\nconst weatherDescription =\n  weatherCodes[current.weather_code] ||\n  \"Unknown weather\";\n\nconst briefing =\n  aiResponse.choices?.[0]?.message?.content ||\n  \"AI briefing could not be generated.\";\n\nreturn [\n  {\n    json: {\n      briefing_date: new Date().toISOString().split('T')[0],\n\n      city: \"Rawalpindi\",\n\n      temperature: current.temperature_2m ?? null,\n\n      weather: weatherDescription,\n\n      country: country.names?.common ?? \"Unknown\",\n\n      country_capital:\n        country.capitals?.[0]?.name ?? \"Unknown\",\n\n      country_population:\n        country.population ?? null,\n\n      ai_briefing: briefing.trim()\n    }\n  }\n];"
      },
